<?xml version="1.0"?>
<robot name="cyphal_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Minimal robot structure -->
  <link name="base_link"/>
  <link name="link1"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="1.0"/>
  </joint>

  <ros2_control name="CyphalRobot" type="system">
  <hardware>
    <plugin>ros2_cyphal_hardware/CyphalSystemHardware</plugin>
    <param name="can_interface">vcan0</param>
    <param name="node_id">123</param>
  </hardware>

  <joint name="joint1">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>

    <cyphal>
      <state dsdl_type="reg.udral.physics.kinematics.rotation.Planar.0.1" subject_id="101">
        <map interface="position" member="angular_position.radian"/>
        <map interface="velocity" member="angular_velocity.radian_per_second"/>
      </state>
      <command dsdl_type="reg.udral.physics.kinematics.rotation.PlanarTs.0.1" subject_id="201">
        <map interface="position" member="value.angular_position.radian"/>
      </command>
    </cyphal>
  </joint>
</ros2_control>
</robot>
